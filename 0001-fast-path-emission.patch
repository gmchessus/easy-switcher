+
+void VirtualKeyboard::emit_key_fast(int code, int value) {
+    if (!uidev_) return;
+
+    libevdev_uinput_write_event(uidev_, EV_KEY, code, value);
+    libevdev_uinput_write_event(uidev_, EV_SYN, SYN_REPORT, 0);
+
+    usleep(2 * 1000);
 }
